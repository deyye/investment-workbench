# 可直接启动后在 /settings/model 配置。界面保存的值优先。
HOST=127.0.0.1
PORT=8765
WORKBENCH_DATA_DIR=./data
# 默认禁止绑定非本机地址。直接对外监听时需同时启用认证与 HTTPS Cookie；
# WORKBENCH_CONTAINER_LOOPBACK_ONLY 仅供官方 Compose 的宿主机回环端口映射使用。
WORKBENCH_ALLOW_REMOTE=false
WORKBENCH_AUTH_USER=
WORKBENCH_AUTH_PASSWORD=
WORKBENCH_COOKIE_SECURE=false
WORKBENCH_CONTAINER_LOOPBACK_ONLY=false
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
LLM_JSON_MODE=true
LLM_EXTRA_BODY={}
LLM_ALLOW_NO_KEY=false
LLM_HTTP_HOSTS=
